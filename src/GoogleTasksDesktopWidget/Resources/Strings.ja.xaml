<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <sys:String x:Key="AppTitle">Google Tasks</sys:String>
  <sys:String x:Key="MoveWidgetHint">ドラッグしてウィジェットを移動</sys:String>
  <sys:String x:Key="Connect">Google Tasks に接続</sys:String>
  <sys:String x:Key="ConnectHint">Google Tasks を表示するには、Google アカウントに接続してください。</sys:String>
  <sys:String x:Key="ConfigureClientId">OAuth クライアント情報を設定してください。</sys:String>
  <sys:String x:Key="AlreadyRunning">Google Tasks Widget はすでに起動しています。</sys:String>
  <sys:String x:Key="ListLabel">タスクリスト</sys:String>
  <sys:String x:Key="AllTasks">すべて</sys:String>
  <sys:String x:Key="TodayTasks">今日まで</sys:String>
  <sys:String x:Key="AddPlaceholder">タスクを追加</sys:String>
  <sys:String x:Key="Add">追加</sys:String>
  <sys:String x:Key="Menu">メニュー</sys:String>
  <sys:String x:Key="MenuLists">タスクリスト</sys:String>
  <sys:String x:Key="MenuFilter">表示</sys:String>
  <sys:String x:Key="MenuRefresh">今すぐ更新</sys:String>
  <sys:String x:Key="MenuLock">位置をロック</sys:String>
  <sys:String x:Key="MenuAutoStart">Windows 起動時に開始</sys:String>
  <sys:String x:Key="MenuTheme">テーマ</sys:String>
  <sys:String x:Key="ThemeSystem">システム設定に合わせる</sys:String>
  <sys:String x:Key="ThemeLight">ライト</sys:String>
  <sys:String x:Key="ThemeDark">ダーク</sys:String>
  <sys:String x:Key="MenuReconnect">Google に再接続</sys:String>
  <sys:String x:Key="MenuLogout">ログアウト</sys:String>
  <sys:String x:Key="MenuExit">終了</sys:String>
  <sys:String x:Key="Online">オンライン</sys:String>
  <sys:String x:Key="OfflineCached">オフライン・保存済みデータを表示中</sys:String>
  <sys:String x:Key="Loading">読み込み中…</sys:String>
  <sys:String x:Key="Empty">タスクはありません</sys:String>
  <sys:String x:Key="NoLists">タスクリストがありません</sys:String>
  <sys:String x:Key="TaskDeleted">タスクを削除しました</sys:String>
  <sys:String x:Key="TaskSaved">タスクを保存しました</sys:String>
  <sys:String x:Key="NetworkError">接続できません。ネットワークを確認してください。</sys:String>
  <sys:String x:Key="PermissionError">Google Tasks へのアクセスが拒否されました。再接続してください。</sys:String>
  <sys:String x:Key="GoogleTasksApiNotEnabled">Google Tasks API を有効にしてください。OAuth クライアント ID と同じ Google Cloud プロジェクトで有効化した後、「今すぐ更新」を押してください。</sys:String>
  <sys:String x:Key="GoogleTasksInsufficientPermissions">Google Tasks の権限が不足しています。Google に再接続し、タスクへのアクセスを許可してください。</sys:String>
  <sys:String x:Key="GoogleTasksDomainPolicy">組織のポリシーにより Google Tasks へのアクセスが制限されています。Google Workspace 管理者に確認してください。</sys:String>
  <sys:String x:Key="GeneralError">処理に失敗しました。もう一度お試しください。</sys:String>
  <sys:String x:Key="SettingsWriteFailed">設定を Data フォルダーに保存できませんでした。書き込み権限と空き容量を確認してください。既存の設定ファイルは保持されています。</sys:String>
  <sys:String x:Key="OAuthError">Google への接続を完了できませんでした。</sys:String>
  <sys:String x:Key="LogoutConfirm">Google アカウントからログアウトしますか？</sys:String>
  <sys:String x:Key="Cancel">キャンセル</sys:String>
  <sys:String x:Key="Delete">削除</sys:String>
  <sys:String x:Key="DueDate">期限</sys:String>
  <sys:String x:Key="OAuthClientSetupTitle">Google OAuth クライアント情報を設定</sys:String>
  <sys:String x:Key="OAuthClientIdHint">1234567890-abc.apps.googleusercontent.com</sys:String>
  <sys:String x:Key="OAuthClientSecretLabel">Client Secret（必要な場合）</sys:String>
  <sys:String x:Key="OAuthClientSecretHint">Desktop 用 JSON から取り込むか、必要な場合に直接入力してください。</sys:String>
  <sys:String x:Key="OAuthClearSavedClientSecret">保存済み Client Secret を削除</sys:String>
  <sys:String x:Key="OAuthClientSecretRequired">この OAuth クライアントには Client Secret が必要です。Desktop 用 JSON を読み込むか、Secret を入力して保存後に再接続してください。</sys:String>
  <sys:String x:Key="OAuthClientSecretInvalid">Client Secret が長すぎるか、入力内容が無効です。</sys:String>
  <sys:String x:Key="OAuthImportJson">Desktop 用 JSON を選択</sys:String>
  <sys:String x:Key="OAuthSaveClientId">保存</sys:String>
  <sys:String x:Key="OAuthClientSetupMenu">OAuth クライアント情報を設定</sys:String>
  <sys:String x:Key="OAuthClientJsonLoaded">Desktop 用 JSON から OAuth 情報を読み込みました。Secret は暗号化して保存します。</sys:String>
  <sys:String x:Key="OAuthClientNotDesktop">Desktop app 用の OAuth JSON を選択してください。</sys:String>
  <sys:String x:Key="OAuthClientIdMissing">JSON に installed.client_id がありません。</sys:String>
  <sys:String x:Key="OAuthClientIdInvalid">有効な *.apps.googleusercontent.com の ID を入力してください。</sys:String>
  <sys:String x:Key="OAuthClientJsonInvalid">OAuth JSON を読み取れませんでした。</sys:String>
  <sys:String x:Key="OAuthClientIdSaved">OAuth 情報を保存しました。Google Tasks に接続してください。</sys:String>
  <sys:String x:Key="OAuthClientChangeCleanupFailed">OAuth 情報は保存しました。古い認証情報を削除できなかったため、Google に再接続してください。</sys:String>
  <sys:String x:Key="OAuthClientIdSaveFailed">クライアント ID を保存できませんでした。</sys:String>
  <sys:String x:Key="OAuthClientSecretSaveFailed">Client Secret を安全に保存できませんでした。Secret を確認して、もう一度保存してください。</sys:String>
  <sys:String x:Key="OAuthClientRollbackFailed">Client Secret の保存に失敗し、以前の設定に戻せませんでした。新しい Client ID で再認証が必要です。保存先を確認してください。</sys:String>
  <sys:String x:Key="ReauthorizationRequired">Google の認証を更新できませんでした。再接続してください。</sys:String>
</ResourceDictionary>
