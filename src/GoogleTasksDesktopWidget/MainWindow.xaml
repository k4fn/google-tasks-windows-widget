<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoogleTasksDesktopWidget" x:Class="GoogleTasksDesktopWidget.MainWindow" Title="マイタスク" Width="340" Height="620" MinWidth="300" MaxWidth="700" MinHeight="300" MaxHeight="850" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontFamily="Yu Gothic UI, Segoe UI" Loaded="OnLoaded" Deactivated="OnWindowDeactivated" SizeChanged="OnSizeChanged" PreviewMouseRightButtonDown="OnWidgetRightClick">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <local:TaskDepthPaddingConverter x:Key="TaskDepthPaddingConverter"/>
    <local:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
    <Style x:Key="QuietButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="5"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
    </Style>
    <Style x:Key="AddPillButton" TargetType="Button">
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Background" Value="{DynamicResource ActionBlueBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="16" BorderBrush="Transparent" BorderThickness="2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Opacity" Value="0.84"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource TextBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="QuickDateButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource SelectedBrush}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource SelectedLineBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="QuickDateClearButton" TargetType="Button" BasedOn="{StaticResource QuickDateButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding DraftDueDate}" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="WidgetTextBox" TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="Padding" Value="8"/>
    </Style>
    <Style x:Key="TaskCircle" TargetType="CheckBox">
      <Setter Property="Width" Value="21"/>
      <Setter Property="Height" Value="21"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Ellipse x:Name="Circle" Width="16" Height="16" Stroke="{DynamicResource CheckboxBrush}" StrokeThickness="1.5" Fill="Transparent"/>
              <Path x:Name="Tick" Data="M 6,11 L 9,14 L 15,7" Stroke="{DynamicResource ActionBlueBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource ActionBlueBrush}"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                <Setter TargetName="Circle" Property="Stroke" Value="Transparent"/>
                <Setter TargetName="Tick" Property="Stroke" Value="{DynamicResource ActionBlueBrush}"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CompletedToggle" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid Height="34" Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Path x:Name="ChevronRight" Data="M 1.75,0 L 1.75,7 L 5.25,3.5 Z" Fill="{DynamicResource SubtleTextBrush}" Width="7" Height="7" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              <Path x:Name="ChevronDown" Data="M 0,1.75 L 7,1.75 L 3.5,5.25 Z" Fill="{DynamicResource SubtleTextBrush}" Width="7" Height="7" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ChevronRight" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="ChevronDown" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="InvisibleScrollRepeatButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MinimalScrollThumb" TargetType="Thumb">
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Grid Background="Transparent">
              <Border x:Name="ThumbLine" Width="4" CornerRadius="2" HorizontalAlignment="Center" Background="{DynamicResource SubtleTextBrush}" Opacity="0.42"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ThumbLine" Property="Opacity" Value="0.72"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="ThumbLine" Property="Opacity" Value="0.82"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MinimalTaskScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Width="10" Background="Transparent">
              <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                     Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource InvisibleScrollRepeatButton}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource MinimalScrollThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource InvisibleScrollRepeatButton}"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TaskMenuButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Visibility" Value="Visible"/>
      <Setter Property="Opacity" Value="0"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}" Value="True">
          <Setter Property="Opacity" Value="1"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TaskTitleText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
          <Setter Property="TextDecorations" Value="Strikethrough"/>
          <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TaskDueInfo" TargetType="StackPanel">
      <Setter Property="Orientation" Value="Horizontal"/>
      <Setter Property="Margin" Value="1,4,0,0"/>
      <Setter Property="Tag" Value="{DynamicResource CheckboxBrush}"/>
      <Setter Property="Visibility" Value="{Binding HasDueDate, Converter={StaticResource BoolToVisibilityConverter}}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
          <Setter Property="Tag" Value="{DynamicResource OverdueBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsDetailsExpanded}" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="InlineEditorTextBox" TargetType="TextBox" BasedOn="{StaticResource WidgetTextBox}">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0,2"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <ContextMenu x:Key="ListSelectorMenu" x:Shared="False" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" Foreground="{DynamicResource TextBrush}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="OnListSelectorMenuOpened" Closed="OnTaskContextMenuClosed"/>
    <!-- PlacementTarget supplies the current row to this shared menu. -->
    <ContextMenu x:Key="TaskContextMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" Foreground="{DynamicResource TextBrush}" Opened="OnTaskContextMenuOpened" Closed="OnTaskContextMenuClosed">
      <MenuItem Header="期限を追加" Click="OnTaskDueMenuClick"/>
      <MenuItem Header="サブタスクを追加" Click="OnAddSubtaskClick"/>
      <MenuItem Header="{DynamicResource Delete}" Click="OnDeleteTaskClick"/>
      <Separator/>
      <MenuItem x:Name="TaskMoveListMenu" Header="マイタスク" SubmenuOpened="OnTaskMoveListMenuOpened"/>
      <MenuItem Header="新しいリスト" Click="OnCreateTaskListClick" StaysOpenOnClick="True"/>
    </ContextMenu>
    <!-- Closed rows retain only presenters; create editors and calendars on demand. -->
    <DataTemplate x:Key="TaskTitleEditor">
        <TextBox x:Name="InlineTaskTitle" Text="{Binding EditDraft, UpdateSourceTrigger=PropertyChanged}" FontSize="15" MaxLength="1024" TextWrapping="Wrap" VerticalContentAlignment="Center" MinHeight="28" Style="{StaticResource InlineEditorTextBox}" PreviewKeyDown="OnInlineTaskTitleKeyDown"/>
    </DataTemplate>
    <DataTemplate x:Key="TaskDetailsEditor">
      <StackPanel Margin="0,2,0,0">
        <Grid MinHeight="26" Margin="1,0,0,7">
          <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Path Data="M 1,2 L 15,2 M 1,6 L 15,6 M 1,10 L 11,10" Stroke="{DynamicResource SubtleTextBrush}" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="12" Stretch="None" VerticalAlignment="Center"/>
          <Grid Grid.Column="1">
            <TextBox x:Name="InlineTaskNotes" Text="{Binding DraftNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="24" MaxLength="8192" Style="{StaticResource InlineEditorTextBox}" ToolTip="詳細" VerticalContentAlignment="Center" PreviewKeyDown="OnInlineTaskNotesKeyDown"/>
            <TextBlock Text="詳細" Margin="0,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource PlaceholderBrush}" IsHitTestVisible="False" Visibility="{Binding DraftNotes, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
          </Grid>
        </Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,1">
          <Button Content="今日" Tag="Today" Click="OnQuickDueClick" Style="{StaticResource QuickDateButton}" Margin="0,0,5,0"/>
          <Button Content="明日" Tag="Tomorrow" Click="OnQuickDueClick" Style="{StaticResource QuickDateButton}" Margin="0,0,5,0"/>
          <Button x:Name="InlineTaskCalendarButton" Click="OnOpenTaskCalendarClick" Style="{StaticResource QuickDateButton}" Padding="8,3" ToolTip="日付を選択" AutomationProperties.Name="日付を選択">
            <StackPanel Orientation="Horizontal">
              <Path Data="M 3,1 L 3,4 M 11,1 L 11,4 M 1,4 L 13,4 L 13,13 L 1,13 Z M 1,7 L 13,7" Width="13" Height="13" Stretch="Fill" Stroke="{DynamicResource SubtleTextBrush}" StrokeThickness="1.1"/>
              <TextBlock Text="{Binding DraftDueDate, StringFormat={}{0:M月d日}}" Margin="4,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Content="×" Tag="Clear" Click="OnQuickDueClick" Style="{StaticResource QuickDateClearButton}" Width="26" Padding="0" Margin="4,0,0,0" ToolTip="日付を解除" AutomationProperties.Name="日付を解除"/>
        </StackPanel>
        <Popup x:Name="InlineTaskCalendarPopup" PlacementTarget="{Binding ElementName=InlineTaskCalendarButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
          <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="5">
            <Calendar x:Name="InlineTaskCalendar" SelectedDatesChanged="OnInlineTaskCalendarSelectionChanged"/>
          </Border>
        </Popup>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="TaskRow">
      <Border Background="Transparent" Padding="{Binding Depth, Converter={StaticResource TaskDepthPaddingConverter}}" MouseEnter="OnTaskRowMouseEnter" MouseLeave="OnTaskRowMouseLeave" MouseLeftButtonDown="OnTaskRowMouseLeftButtonDown" ContextMenu="{StaticResource TaskContextMenu}" ContextMenuService.IsEnabled="{Binding IsPersisted}" Cursor="Hand">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="26"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="32"/>
          </Grid.ColumnDefinitions>
          <CheckBox Style="{StaticResource TaskCircle}" IsChecked="{Binding IsCompleted, Mode=OneWay}" IsEnabled="{Binding IsPersisted}" Click="OnTaskCompletionChanged" VerticalAlignment="Top" Margin="0,5,0,0"/>
          <StackPanel Grid.Column="1" Margin="2,0,1,0">
            <Grid MinHeight="28">
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource TaskTitleText}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsDetailsExpanded}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <ContentControl Focusable="False">
                <ContentControl.Style>
                  <Style TargetType="ContentControl">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsDetailsExpanded}" Value="True">
                        <Setter Property="Content" Value="{Binding}"/>
                        <Setter Property="ContentTemplate" Value="{StaticResource TaskTitleEditor}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ContentControl.Style>
              </ContentControl>
            </Grid>
            <StackPanel Style="{StaticResource TaskDueInfo}">
              <Path Data="M 12,2 A 10,10 0 1 1 11.99,2 M 12,6 L 12,12 L 16,15" Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Tag, RelativeSource={RelativeSource AncestorType=StackPanel}}" StrokeThickness="1.6"/>
              <TextBlock Text="{Binding DueDateText}" Margin="6,-2,0,0" FontSize="12" Foreground="{Binding Tag, RelativeSource={RelativeSource AncestorType=StackPanel}}"/>
            </StackPanel>
            <TextBlock Text="{Binding CompletedDateText}" Margin="1,3,0,0" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <ContentControl Focusable="False">
              <ContentControl.Style>
                <Style TargetType="ContentControl">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDetailsExpanded}" Value="True">
                      <Setter Property="Content" Value="{Binding}"/>
                      <Setter Property="ContentTemplate" Value="{StaticResource TaskDetailsEditor}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ContentControl.Style>
            </ContentControl>
          </StackPanel>
          <Button Grid.Column="2" Style="{StaticResource TaskMenuButton}" Visibility="{Binding IsPersisted, Converter={StaticResource BoolToVisibilityConverter}}" Click="OnTaskOptionsClick" ToolTip="タスクのオプション" AutomationProperties.Name="タスクのオプション" VerticalAlignment="Top" Margin="0,-1,0,0">
            <TextBlock Text="⋮" FontSize="19" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center"/>
          </Button>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Border x:Name="WidgetSurface" Background="{DynamicResource SurfaceBrush}" CornerRadius="19" Padding="15,4,13,8">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="10"/>
        <RowDefinition Height="42"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="28"/>
      </Grid.RowDefinitions>
      <Border x:Name="DragHandle" Grid.Row="0" Width="80" Height="20" HorizontalAlignment="Center" VerticalAlignment="Top" Background="Transparent" Cursor="SizeAll" ToolTip="ドラッグして移動" MouseLeftButtonDown="OnDragHandleMouseDown" MouseMove="OnDragHandleMouseMove" MouseLeftButtonUp="OnDragHandleMouseUp" LostMouseCapture="OnDragHandleLostCapture">
        <Border Width="80" Height="5" CornerRadius="3" Background="{DynamicResource DragHandleBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"/>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="ListButton" Style="{StaticResource QuietButton}" Click="OnListButtonClick" VerticalAlignment="Center" MinHeight="38" MaxWidth="165" Padding="4,0" ToolTip="タスクリストを選択">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedListTitle}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="135" VerticalAlignment="Center"/>
            <Path Data="M 0,0 L 8,0 L 4,4 Z" Fill="{DynamicResource TextBrush}" Width="8" Height="4" Stretch="None" Margin="8,0,2,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="SettingsButton" Click="OnMenuClick" Style="{StaticResource QuietButton}" Width="32" Height="32" Margin="0,0,5,0" ToolTip="並び替えと設定" AutomationProperties.Name="並び替えと設定" FontSize="22">
            <TextBlock Text="⋮" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="0,-2,0,0"/>
          </Button>
          <Button Click="OnTopAddClick" Style="{StaticResource AddPillButton}" IsEnabled="{Binding IsConnected}" ToolTip="タスクを追加" AutomationProperties.Name="タスクを追加">
            <Path Data="M 11,2 L 11,20 M 2,11 L 20,11" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
        </StackPanel>
      </Grid>
      <ScrollViewer x:Name="TaskScrollViewer" Grid.Row="2" Background="Transparent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="OnTaskScrollChanged">
        <ScrollViewer.Resources>
          <Style TargetType="ScrollBar" BasedOn="{StaticResource MinimalTaskScrollBar}"/>
        </ScrollViewer.Resources>
        <StackPanel>
          <ItemsControl x:Name="DatedTasksItemsControl" ItemsSource="{Binding DatedTasks}" ItemTemplate="{StaticResource TaskRow}" IsEnabled="{Binding IsConnected}"/>
          <ContentControl x:Name="DraftTaskPresenter" ContentTemplate="{StaticResource TaskRow}" Visibility="Collapsed"/>
          <ItemsControl x:Name="OpenTasksItemsControl" ItemsSource="{Binding UndatedTasks}" ItemTemplate="{StaticResource TaskRow}" IsEnabled="{Binding IsConnected}"/>
          <StackPanel HorizontalAlignment="Center" MaxWidth="275" Visibility="{Binding ShowConnectPanel, Converter={StaticResource BoolToVisibilityConverter}}" Margin="4,22">
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,12"/>
            <Button Content="{DynamicResource Connect}" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}" Padding="14,8"/>
          </StackPanel>
          <Border HorizontalAlignment="Center" MaxWidth="330" Margin="0,14,0,0" Padding="12" CornerRadius="14" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Visibility="{Binding ShowClientIdSetupPanel, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <TextBlock Text="{DynamicResource OAuthClientSetupTitle}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" TextAlignment="Center" Margin="4,2,4,9" TextWrapping="Wrap"/>
              <TextBox Text="{Binding ClientIdInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="256" Style="{StaticResource WidgetTextBox}" ToolTip="{DynamicResource OAuthClientIdHint}"/>
              <TextBlock Text="{DynamicResource OAuthClientSecretLabel}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" Margin="2,8,2,3"/>
              <PasswordBox x:Name="ClientSecretBox" MaxLength="4096" PasswordChanged="OnClientSecretChanged" Padding="8,6" MinHeight="34" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}" ToolTip="{DynamicResource OAuthClientSecretHint}"/>
              <CheckBox Content="{DynamicResource OAuthClearSavedClientSecret}" IsChecked="{Binding ClearExistingClientSecret, UpdateSourceTrigger=PropertyChanged}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" Margin="2,6,2,1"/>
              <TextBlock Text="{Binding ClientIdSetupMessage}" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="3,6"/>
              <WrapPanel HorizontalAlignment="Center" Margin="0,3,0,0">
                <Button Content="{DynamicResource OAuthImportJson}" Click="OnImportClientIdClick" Style="{StaticResource QuietButton}" Margin="2"/>
                <Button Content="{DynamicResource OAuthSaveClientId}" Command="{Binding SaveClientIdCommand}" IsEnabled="{Binding CanSaveClientId}" Style="{StaticResource PrimaryButton}" Margin="2"/>
                <Button Content="{DynamicResource Cancel}" Command="{Binding CancelClientIdSetupCommand}" Style="{StaticResource QuietButton}" Margin="2"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <TextBlock Text="{DynamicResource Empty}" Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Center" Margin="8,30" Visibility="{Binding HasNoTasks, Converter={StaticResource BoolToVisibilityConverter}}"/>
          <TextBlock Text="{DynamicResource NoLists}" Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Center" Margin="8,30" Visibility="{Binding HasNoLists, Converter={StaticResource BoolToVisibilityConverter}}"/>
          <ToggleButton IsChecked="{Binding IsCompletedSectionExpanded, Mode=OneWay}" Click="OnCompletedToggleClick" Style="{StaticResource CompletedToggle}" Margin="0,13,7,2" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="完了したタスクを表示">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="完了" FontSize="13" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,6,0"/>
              <TextBlock Text="{Binding CompletedTaskCount, StringFormat=（{0}件）}" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
          </ToggleButton>
          <ItemsControl x:Name="CompletedTasksItemsControl" ItemTemplate="{StaticResource TaskRow}" Visibility="{Binding IsCompletedSectionExpanded, Converter={StaticResource BoolToVisibilityConverter}}"/>
          <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>
      </ScrollViewer>
      <TextBlock Grid.Row="3" Text="{Binding SnackbarMessage}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11"/>
      <Border x:Name="ResizeGrip" Grid.Row="3" Width="30" Height="28" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNWSE" ToolTip="ドラッグしてサイズ変更" MouseLeftButtonDown="OnResizeGripMouseDown" MouseMove="OnResizeGripMouseMove" MouseLeftButtonUp="OnResizeGripMouseUp" LostMouseCapture="OnResizeGripLostCapture">
        <Path Data="M 10,17 L 17,10 M 14,19 L 20,13" Stroke="{DynamicResource SubtleTextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,3"/>
      </Border>
    </Grid>
  </Border>
  <Window.ContextMenu>
    <ContextMenu x:Name="WidgetMenu" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" Foreground="{DynamicResource TextBrush}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="OnContextMenuOpened">
      <MenuItem Header="並び替え" SubmenuOpened="OnSortMenuOpened">
        <MenuItem Header="指定した順序" Tag="Manual" IsCheckable="True" Click="OnSortOrderClick"/>
        <MenuItem Header="期日" Tag="DueDate" IsCheckable="True" Click="OnSortOrderClick"/>
        <MenuItem Header="タイトル" Tag="Title" IsCheckable="True" Click="OnSortOrderClick"/>
      </MenuItem>
      <MenuItem Header="{DynamicResource MenuRefresh}" Command="{Binding RefreshCommand}"/>
      <MenuItem x:Name="RefreshIntervalMenu" Header="自動更新間隔" SubmenuOpened="OnRefreshIntervalMenuOpened">
        <MenuItem Header="30秒" Tag="30" IsCheckable="True" Click="OnRefreshIntervalPresetClick"/>
        <MenuItem Header="1分" Tag="60" IsCheckable="True" Click="OnRefreshIntervalPresetClick"/>
        <MenuItem Header="5分" Tag="300" IsCheckable="True" Click="OnRefreshIntervalPresetClick"/>
        <MenuItem Header="15分" Tag="900" IsCheckable="True" Click="OnRefreshIntervalPresetClick"/>
        <MenuItem Header="1時間" Tag="3600" IsCheckable="True" Click="OnRefreshIntervalPresetClick"/>
        <Separator/>
        <MenuItem StaysOpenOnClick="True">
          <MenuItem.Header>
            <StackPanel Width="210">
              <TextBlock Text="秒数を指定（10～86400秒）" Margin="0,0,0,6"/>
              <StackPanel Orientation="Horizontal">
                <TextBox x:Name="RefreshIntervalBox" Width="112" MaxLength="5" Style="{StaticResource WidgetTextBox}" PreviewKeyDown="OnRefreshIntervalKeyDown" AutomationProperties.Name="自動更新間隔（秒）"/>
                <Button Content="適用" Margin="8,0,0,0" Padding="8,4" Style="{StaticResource PrimaryButton}" Click="OnApplyRefreshIntervalClick"/>
              </StackPanel>
              <TextBlock x:Name="RefreshIntervalError" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource SubtleTextBrush}" Visibility="Collapsed"/>
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="{DynamicResource OAuthClientSetupMenu}" Command="{Binding ConfigureClientIdCommand}"/>
      <Separator/>
      <MenuItem Header="{DynamicResource MenuLock}" IsCheckable="True" x:Name="LockMenuItem" Click="OnLockMenuClick"/>
      <MenuItem Header="{DynamicResource MenuAutoStart}" IsCheckable="True" x:Name="AutoStartMenuItem" Click="OnAutoStartMenuClick"/>
      <MenuItem Header="{DynamicResource MenuTheme}">
        <MenuItem Header="{DynamicResource ThemeSystem}" IsCheckable="True" x:Name="SystemThemeMenuItem" Click="OnThemeMenuClick"/>
        <MenuItem Header="{DynamicResource ThemeLight}" IsCheckable="True" x:Name="LightThemeMenuItem" Click="OnThemeMenuClick"/>
        <MenuItem Header="{DynamicResource ThemeDark}" IsCheckable="True" x:Name="DarkThemeMenuItem" Click="OnThemeMenuClick"/>
      </MenuItem>
      <Separator/>
      <MenuItem Header="{DynamicResource MenuReconnect}" Command="{Binding ReconnectCommand}"/>
      <MenuItem Header="{DynamicResource MenuLogout}" Command="{Binding LogoutCommand}"/>
      <MenuItem Header="{DynamicResource MenuExit}" Command="{Binding ExitCommand}"/>
    </ContextMenu>
  </Window.ContextMenu>
</Window>
