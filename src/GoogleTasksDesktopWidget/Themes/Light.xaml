<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Opaque light surfaces with Google's familiar task blue. -->
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFF2F2F2" />
  <SolidColorBrush x:Key="SurfaceLineBrush" Color="#FFE0E3E7" />
  <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="TextBrush" Color="#FF202124" />
  <SolidColorBrush x:Key="SubtleTextBrush" Color="#FF687078" />
  <SolidColorBrush x:Key="PlaceholderBrush" Color="#FF7D848C" />
  <SolidColorBrush x:Key="AccentBrush" Color="#FF1A73E8" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF1558B0" />
  <SolidColorBrush x:Key="ActionBlueBrush" Color="#FF496DA8" />
  <SolidColorBrush x:Key="OverdueBrush" Color="#FFB3261E" />
  <SolidColorBrush x:Key="DragHandleBrush" Color="#FFC5C9C7" />
  <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="LineBrush" Color="#FFDADCE0" />
  <SolidColorBrush x:Key="InputLineBrush" Color="#FFBDC1C6" />
  <SolidColorBrush x:Key="CheckboxBrush" Color="#FF222222" />
  <SolidColorBrush x:Key="HoverBrush" Color="#FFE9E9E9" />
  <SolidColorBrush x:Key="SelectedBrush" Color="#FFE8F0FE" />
  <SolidColorBrush x:Key="SelectedLineBrush" Color="#FF1A73E8" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#FFAECBFA" />
  <SolidColorBrush x:Key="DangerBrush" Color="#FFB3261E" />
  <SolidColorBrush x:Key="InputBrush" Color="#FFFFFFFF" />
</ResourceDictionary>
